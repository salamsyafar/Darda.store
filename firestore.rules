rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories: readable by anyone, writable by authenticated users / admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // UMKM profiles: readable by anyone, manageable by admin
    match /umkm/{umkmId} {
      allow read: if true;
      allow write: if true;
    }

    // Products: readable by anyone, manageable by admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Applications: Jamaah can submit, admin can read/manage
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // Stats and telemetry
    match /stats/{statId} {
      allow read, write: if true;
    }

    // Admin & Super Admin users
    match /admin_users/{adminId} {
      allow read, write: if true;
    }

    // Seller order notes
    match /seller_orders/{orderId} {
      allow read, write: if true;
    }
  }
}
