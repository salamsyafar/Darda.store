{
  "entities": {
    "UMKM": {
      "title": "UMKM",
      "description": "Profil usaha mikro, kecil, dan menengah binaan jamaah Masjid Darussalam Dua",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier unik UMKM"
        },
        "business_name": {
          "type": "string",
          "description": "Nama unit usaha atau merk dagang"
        },
        "owner_name": {
          "type": "string",
          "description": "Nama lengkap jamaah pemilik usaha"
        },
        "category": {
          "type": "string",
          "description": "Kategori bidang usaha"
        },
        "whatsapp": {
          "type": "string",
          "description": "Nomor WhatsApp aktif untuk pemesanan (format 62...)"
        },
        "address": {
          "type": "string",
          "description": "Alamat fisik atau lokasi usaha di lingkungan sekitar masjid"
        },
        "description": {
          "type": "string",
          "description": "Deskripsi detail profil dan keunggulan usaha"
        },
        "image": {
          "type": "string",
          "description": "URL foto tempat usaha atau logo UMKM"
        },
        "status": {
          "type": "string",
          "description": "Status keaktifan UMKM (active / inactive)",
          "enum": ["active", "inactive"]
        },
        "created_at": {
          "type": "string",
          "description": "Waktu pendaftaran data UMKM"
        },
        "rating": {
          "type": "number",
          "description": "Rating kepuasan jamaah"
        }
      },
      "required": ["id", "business_name", "owner_name", "whatsapp", "category"]
    },
    "Product": {
      "title": "Product",
      "description": "Produk barang atau jasa yang ditawarkan oleh UMKM jamaah",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier unik produk"
        },
        "name": {
          "type": "string",
          "description": "Nama produk barang atau jasa"
        },
        "description": {
          "type": "string",
          "description": "Rincian spesifikasi, bahan, varian produk"
        },
        "price": {
          "type": "number",
          "description": "Harga produk dalam satuan Rupiah (IDR)"
        },
        "image": {
          "type": "string",
          "description": "URL foto produk"
        },
        "category": {
          "type": "string",
          "description": "Kategori produk"
        },
        "umkm_id": {
          "type": "string",
          "description": "ID UMKM yang memproduksi atau menjual produk ini"
        },
        "status": {
          "type": "string",
          "description": "Status publikasi di katalog (published / draft)",
          "enum": ["published", "draft"]
        },
        "created_at": {
          "type": "string",
          "description": "Waktu produk ditambahkan"
        },
        "is_featured": {
          "type": "boolean",
          "description": "Apakah produk merupakan produk pilihan utama di beranda"
        }
      },
      "required": ["id", "name", "price", "category", "umkm_id", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Kategori klasifikasi produk dan jasa di Darda Store",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier unik kategori"
        },
        "name": {
          "type": "string",
          "description": "Nama kategori produk"
        },
        "icon": {
          "type": "string",
          "description": "Nama icon representasi kategori"
        },
        "description": {
          "type": "string",
          "description": "Penjelasan singkat isi kategori"
        }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "Pengguna dan pengurus admin Masjid Darussalam Dua",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier unik pengguna"
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap"
        },
        "email": {
          "type": "string",
          "description": "Alamat email"
        },
        "role": {
          "type": "string",
          "description": "Peran pengguna (admin / customer)",
          "enum": ["admin", "customer"]
        },
        "created_at": {
          "type": "string",
          "description": "Waktu akun dibuat"
        }
      },
      "required": ["id", "email", "role"]
    },
    "AppStats": {
      "title": "AppStats",
      "description": "Statistik agregat pengunjung dan pesanan Darda Store",
      "type": "object",
      "properties": {
        "visitorsCount": {
          "type": "number",
          "description": "Jumlah pengunjung katalog"
        },
        "whatsappInquiries": {
          "type": "number",
          "description": "Jumlah klik pesanan WhatsApp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan statistik"
        }
      }
    },
    "UMKMApplication": {
      "title": "UMKMApplication",
      "description": "Pengajuan pendaftaran mandiri UMKM baru oleh jamaah Masjid Darussalam Dua",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_name": { "type": "string", "description": "Nama lengkap jamaah pemilik usaha" },
        "business_name": { "type": "string", "description": "Nama unit usaha / merk" },
        "category": { "type": "string", "description": "Kategori produk/jasa" },
        "whatsapp": { "type": "string", "description": "Nomor WhatsApp aktif" },
        "address": { "type": "string", "description": "Alamat tempat tinggal / usaha jamaah" },
        "description": { "type": "string", "description": "Deskripsi produk dan komitmen halal" },
        "image": { "type": "string", "description": "Foto logo / tempat usaha" },
        "first_product_name": { "type": "string", "description": "Nama produk pertama yang ingin didaftarkan" },
        "first_product_price": { "type": "number", "description": "Harga produk pertama" },
        "first_product_image": { "type": "string", "description": "Foto produk pertama" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Status persetujuan pengurus"
        },
        "created_at": { "type": "string", "description": "Waktu pendaftaran diajukan" },
        "admin_notes": { "type": "string", "description": "Catatan pengurus untuk pendaftar" }
      },
      "required": ["id", "owner_name", "business_name", "whatsapp", "category", "status"]
    }
  },
  "firestore": {
    "/umkm/{umkmId}": {
      "schema": "UMKM",
      "description": "Koleksi data profil UMKM jamaah masjid"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Koleksi produk yang dijual oleh UMKM"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Koleksi kategori produk"
    },
    "/applications/{applicationId}": {
      "schema": "UMKMApplication",
      "description": "Koleksi formulir pendaftaran mandiri UMKM dari jamaah"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Koleksi akun pengguna dan pengurus"
    },
    "/stats/{statId}": {
      "schema": "AppStats",
      "description": "Koleksi metrik statistik pengunjung dan pemesanan"
    }
  }
}
